{
  "name": "telegram-church-bot",
  "version": "0.2.0",
  "private": true,
  "description": "Church community assistant for Telegram",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts eslint.config.js vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "telegram:setup": "tsx scripts/setup-telegram.ts",
    "db:backup": "sh scripts/backup-postgres.sh",
    "db:restore": "sh scripts/restore-postgres.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.0",
    "luxon": "^3.7.2",
    "prisma": "^6.12.0",
    "undici": "^7.29.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11"
  }
}
