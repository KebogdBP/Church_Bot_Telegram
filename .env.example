# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
APP_TIMEZONE=Europe/Moscow
APP_PRIVACY_SECRET=
OUTBOUND_PROXY_URL=
LOG_LEVEL=info

# Telegram bot credentials
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Comma-separated Telegram user IDs, for example: 123456,789012
TELEGRAM_ADMIN_USER_IDS=
# Use polling for local development and webhook for production.
TELEGRAM_UPDATE_MODE=webhook
TELEGRAM_POLL_INTERVAL_MS=1000

# Used from Phase 2 onward
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/telegram_church_bot
POSTGRES_PASSWORD=change-me-in-production
REMINDER_POLL_INTERVAL_MS=30000

# Sermon audio intake (hosted Telegram Bot API downloads files up to 20 MB)
SERMON_DOWNLOAD_INTERVAL_MS=30000
SERMON_MAX_FILE_SIZE_BYTES=20971520
# Public HTTPS links only. Large sources are segmented before Groq transcription.
SERMON_MAX_LINK_FILE_SIZE_BYTES=524288000
SERMON_STORAGE_DIR=data/sermons

# Queue / scheduler
REDIS_URL=redis://localhost:6379

# AI providers: Gemini for text, Groq Whisper for sermon transcription
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=deepseek/deepseek-v3.2
OPENROUTER_STRUCTURED_MODEL=qwen/qwen3-30b-a3b
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
TRANSCRIPTION_LANGUAGE=ru
TRANSCRIPTION_POLL_INTERVAL_MS=30000
CONTENT_GENERATION_POLL_INTERVAL_MS=30000
SERMON_POST_POLL_INTERVAL_MS=30000
SERMON_NOTIFICATION_POLL_INTERVAL_MS=15000
WEEKLY_DIGEST_POLL_INTERVAL_MS=60000
ANNOUNCEMENT_POLL_INTERVAL_MS=15000
PRAYER_REQUEST_POLL_INTERVAL_MS=15000
