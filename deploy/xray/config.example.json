{
  "log": { "loglevel": "warning" },
  "inbounds": [{
    "listen": "0.0.0.0",
    "port": 10809,
    "protocol": "http",
    "settings": {}
  }],
  "outbounds": [{
    "tag": "vless-out",
    "protocol": "vless",
    "settings": {
      "vnext": [{
        "address": "VPN_HOST",
        "port": 443,
        "users": [{ "id": "VPN_UUID", "encryption": "none", "flow": "xtls-rprx-vision" }]
      }]
    },
    "streamSettings": {
      "network": "tcp",
      "security": "reality",
      "realitySettings": {
        "serverName": "VPN_SNI",
        "fingerprint": "firefox",
        "publicKey": "VPN_PUBLIC_KEY",
        "shortId": "VPN_SHORT_ID",
        "spiderX": "/"
      }
    }
  }]
}
