generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventRecurrence {
  NONE
  WEEKLY
}

enum ReminderDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum SermonAudioKind {
  AUDIO
  VOICE
  DOCUMENT
}

enum SermonPurpose {
  CHURCH_SERMON
  PERSONAL_TRANSCRIPTION
}

enum SermonStatus {
  RECEIVED
  DOWNLOADING
  STORED
  TOO_LARGE
  FAILED
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ContentGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SermonPostStatus {
  DRAFT
  REJECTED
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

enum AssistantOutcome {
  ANSWERED
  ESCALATED
  FAILED
}

enum WeeklyDigestStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

enum DailyDevotionalStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

enum EventRsvpResponse {
  GOING
  MAYBE
  NOT_GOING
}

enum AnnouncementStatus {
  DRAFT
  REJECTED
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

enum PrayerVisibility {
  LEADERS_ONLY
  ANONYMOUS_SHARE
}

enum PrayerRequestStatus {
  SUBMITTED
  ACKNOWLEDGED
  PUBLIC_SCHEDULED
  PUBLIC_PROCESSING
  PUBLISHED
  FAILED
  ARCHIVED
}

model ChurchGroup {
  id        String   @id @default(cuid())
  telegramChatId String   @unique
  timezone  String   @default("Europe/Moscow")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
  sermons   Sermon[]
  sermonPosts SermonPost[]
  assistantContext String?
  assistantInteractions AssistantInteraction[]
  assistantConversationTurns AssistantConversationTurn[]
  admins    GroupAdmin[]
  adminFlows AdminFlow[]
  weeklyDigests WeeklyDigest[]
  dailyDevotionals DailyDevotional[]
  devotionalEnabled Boolean @default(false)
  devotionalLocalTime String @default("08:00")
  digestEnabled Boolean @default(false)
  digestWeekday Int @default(5)
  digestLocalTime String @default("18:00")
  announcements Announcement[]
  prayerRequests PrayerRequest[]
  auditEntries AuditEntry[]
  retentionFileDeletions RetentionFileDeletion[]
  audioRetentionDays Int @default(90)
  transcriptRetentionDays Int @default(365)
  prayerRetentionDays Int @default(365)
}

model RetentionFileDeletion {
  id            String      @id @default(cuid())
  churchGroupId String
  churchGroup   ChurchGroup @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  path          String      @unique
  attempts      Int         @default(0)
  lastError     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([churchGroupId, createdAt])
}

model AuditEntry {
  id            String      @id @default(cuid())
  churchGroupId String
  churchGroup   ChurchGroup @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  actorUserId   String
  action        String
  entityType    String
  entityId      String?
  metadata      Json        @default("{}")
  createdAt     DateTime    @default(now())

  @@index([churchGroupId, createdAt])
  @@index([churchGroupId, action])
}

model PrayerRequest {
  id                   String              @id @default(cuid())
  churchGroupId        String
  churchGroup          ChurchGroup         @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  submitterUserId      String
  text                 String
  visibility           PrayerVisibility
  status               PrayerRequestStatus @default(SUBMITTED)
  anonymousPublicDraft String?
  availableAt          DateTime             @default(now())
  attempts             Int                  @default(0)
  acknowledgedByUserId String?
  acknowledgedAt       DateTime?
  approvedByUserId     String?
  approvedAt            DateTime?
  archivedByUserId     String?
  archivedAt            DateTime?
  publishedAt           DateTime?
  lastError             String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([churchGroupId, status, createdAt])
  @@index([status, availableAt])
}

model Announcement {
  id               String             @id @default(cuid())
  churchGroupId    String
  churchGroup      ChurchGroup        @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  content          String
  status           AnnouncementStatus @default(DRAFT)
  scheduledFor     DateTime?
  availableAt      DateTime            @default(now())
  attempts         Int                 @default(0)
  createdByUserId  String
  editedByUserId   String?
  editedAt         DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  rejectedByUserId String?
  rejectedAt       DateTime?
  sentAt           DateTime?
  lastError        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, availableAt])
  @@index([churchGroupId, status])
}

model WeeklyDigest {
  id               String             @id @default(cuid())
  churchGroupId    String
  churchGroup      ChurchGroup        @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  weekStart        DateTime
  content          String
  status           WeeklyDigestStatus @default(DRAFT)
  availableAt      DateTime            @default(now())
  attempts         Int                 @default(0)
  approvedByUserId String?
  approvedAt       DateTime?
  sentAt           DateTime?
  lastError        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([churchGroupId, weekStart])
  @@index([status, availableAt])
}

model DailyDevotional {
  id             String                @id @default(cuid())
  churchGroupId  String
  churchGroup    ChurchGroup           @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  localDate      String
  content        String
  status         DailyDevotionalStatus @default(SCHEDULED)
  availableAt    DateTime
  attempts       Int                   @default(0)
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([churchGroupId, localDate])
  @@index([status, availableAt])
}

model AdminFlow {
  id             String      @id @default(cuid())
  churchGroupId  String
  churchGroup    ChurchGroup @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  telegramUserId String
  kind           String
  step           String
  data           Json        @default("{}")
  expiresAt      DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([churchGroupId, telegramUserId])
  @@index([expiresAt])
}

model GroupAdmin {
  id            String      @id @default(cuid())
  churchGroupId String
  churchGroup   ChurchGroup @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  telegramUserId String
  addedByUserId String
  createdAt     DateTime    @default(now())

  @@unique([churchGroupId, telegramUserId])
}

model AssistantInteraction {
  id            String           @id @default(cuid())
  churchGroupId String
  churchGroup   ChurchGroup      @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  userHash      String
  outcome       AssistantOutcome
  category      String
  model         String?
  createdAt     DateTime         @default(now())

  @@index([churchGroupId, createdAt])
}

model AssistantConversationTurn {
  id               String      @id @default(cuid())
  churchGroupId    String
  churchGroup      ChurchGroup @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  userHash         String
  role             String
  contentEncrypted String
  createdAt        DateTime    @default(now())
  expiresAt        DateTime

  @@index([churchGroupId, userHash, createdAt])
  @@index([expiresAt])
}

model Sermon {
  id                 String          @id @default(cuid())
  publicId           String          @unique @default(dbgenerated("upper(substr(md5(((random())::text || (clock_timestamp())::text)), 1, 6))"))
  churchGroupId      String
  churchGroup        ChurchGroup     @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  purpose            SermonPurpose   @default(CHURCH_SERMON)
  sourceMessageId    String
  submittedByUserId  String?
  audioKind          SermonAudioKind?
  telegramFileId     String?
  telegramFileUniqueId String?
  sourceUrl          String?
  fileName           String?
  mimeType           String?
  fileSize           BigInt?
  durationSeconds    Int?
  title              String?
  performer          String?
  caption            String?
  status             SermonStatus    @default(RECEIVED)
  attempts           Int             @default(0)
  availableAt        DateTime        @default(now())
  telegramFilePath   String?
  storedPath         String?
  storedAt           DateTime?
  lastError          String?
  transcriptionStatus TranscriptionStatus @default(PENDING)
  transcriptionAttempts Int                @default(0)
  transcriptionAvailableAt DateTime        @default(now())
  transcriptionModel String?
  transcript          String?
  transcriptionError String?
  transcribedAt       DateTime?
  contentStatus       ContentGenerationStatus @default(PENDING)
  contentAttempts     Int                     @default(0)
  contentAvailableAt  DateTime                @default(now())
  contentModel        String?
  summary             String?
  outline             Json?
  keyThoughts         Json?
  reflectionQuestions Json?
  followUpPosts       Json?
  contentError        String?
  contentGeneratedAt  DateTime?
  regeneratedByUserId String?
  regeneratedAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  posts              SermonPost[]
  notifications      SermonNotification[]

  @@unique([churchGroupId, sourceMessageId])
  @@index([status, availableAt])
  @@index([status, transcriptionStatus, transcriptionAvailableAt])
  @@index([transcriptionStatus, contentStatus, contentAvailableAt])
  @@index([churchGroupId, storedAt])
}

model SermonNotification {
  id           String                 @id @default(cuid())
  sermonId     String
  sermon       Sermon                 @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  kind         String
  targetChatId String
  message      String
  status       ReminderDeliveryStatus @default(PENDING)
  attempts     Int                    @default(0)
  availableAt  DateTime               @default(now())
  sentAt       DateTime?
  lastError    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([sermonId, kind])
  @@index([status, availableAt])
}

model SermonPost {
  id               String           @id @default(cuid())
  sermonId         String
  sermon           Sermon           @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  churchGroupId    String
  churchGroup      ChurchGroup      @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  sequence         Int
  content          String
  status           SermonPostStatus @default(DRAFT)
  scheduledFor     DateTime?
  availableAt      DateTime         @default(now())
  attempts         Int              @default(0)
  approvedByUserId String?
  approvedAt       DateTime?
  editedByUserId   String?
  editedAt         DateTime?
  rejectedByUserId String?
  rejectedAt       DateTime?
  sentAt           DateTime?
  telegramMessageId String?
  lastError        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([sermonId, sequence])
  @@index([status, availableAt])
  @@index([churchGroupId, status])
}

model Event {
  id                    String          @id @default(cuid())
  churchGroupId         String
  churchGroup           ChurchGroup     @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  location              String?
  topic                 String?
  biblePassage          String?
  startsAt              DateTime
  timezone              String
  recurrence            EventRecurrence @default(NONE)
  weeklyDay             Int?
  localTime             String?
  reminderMinutesBefore Int
  active                 Boolean         @default(true)
  createdByTelegramUserId String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  reminderDeliveries     ReminderDelivery[]
  rsvps                  EventRsvp[]

  @@index([churchGroupId, active, startsAt])
}

model EventRsvp {
  id             String            @id @default(cuid())
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  telegramUserId String
  response       EventRsvpResponse
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([eventId, telegramUserId])
  @@index([eventId, response])
}

model ReminderDelivery {
  id           String                 @id @default(cuid())
  eventId      String
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceAt DateTime
  scheduledFor DateTime
  availableAt  DateTime
  status       ReminderDeliveryStatus @default(PENDING)
  attempts     Int                    @default(0)
  sentAt       DateTime?
  lastError    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([eventId, occurrenceAt])
  @@index([status, availableAt])
}
