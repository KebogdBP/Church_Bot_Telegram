generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventRecurrence {
  NONE
  WEEKLY
}

enum ReminderDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum SermonAudioKind {
  AUDIO
  VOICE
  DOCUMENT
}

enum SermonStatus {
  RECEIVED
  DOWNLOADING
  STORED
  TOO_LARGE
  FAILED
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ContentGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SermonPostStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

enum AssistantOutcome {
  ANSWERED
  ESCALATED
  FAILED
}

model ChurchGroup {
  id        String   @id @default(cuid())
  telegramChatId String   @unique
  timezone  String   @default("Europe/Moscow")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
  sermons   Sermon[]
  sermonPosts SermonPost[]
  assistantContext String?
  assistantInteractions AssistantInteraction[]
}

model AssistantInteraction {
  id            String           @id @default(cuid())
  churchGroupId String
  churchGroup   ChurchGroup      @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  userHash      String
  outcome       AssistantOutcome
  category      String
  model         String?
  createdAt     DateTime         @default(now())

  @@index([churchGroupId, createdAt])
}

model Sermon {
  id                 String          @id @default(cuid())
  churchGroupId      String
  churchGroup        ChurchGroup     @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  sourceMessageId    String
  submittedByUserId  String?
  audioKind          SermonAudioKind
  telegramFileId     String
  telegramFileUniqueId String
  fileName           String?
  mimeType           String?
  fileSize           BigInt?
  durationSeconds    Int?
  title              String?
  performer          String?
  caption            String?
  status             SermonStatus    @default(RECEIVED)
  attempts           Int             @default(0)
  availableAt        DateTime        @default(now())
  telegramFilePath   String?
  storedPath         String?
  lastError          String?
  transcriptionStatus TranscriptionStatus @default(PENDING)
  transcriptionAttempts Int                @default(0)
  transcriptionAvailableAt DateTime        @default(now())
  transcriptionModel String?
  transcript          String?
  transcriptionError String?
  transcribedAt       DateTime?
  contentStatus       ContentGenerationStatus @default(PENDING)
  contentAttempts     Int                     @default(0)
  contentAvailableAt  DateTime                @default(now())
  contentModel        String?
  summary             String?
  keyThoughts         Json?
  reflectionQuestions Json?
  followUpPosts       Json?
  contentError        String?
  contentGeneratedAt  DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  posts              SermonPost[]

  @@unique([churchGroupId, sourceMessageId])
  @@index([status, availableAt])
  @@index([status, transcriptionStatus, transcriptionAvailableAt])
  @@index([transcriptionStatus, contentStatus, contentAvailableAt])
}

model SermonPost {
  id               String           @id @default(cuid())
  sermonId         String
  sermon           Sermon           @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  churchGroupId    String
  churchGroup      ChurchGroup      @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  sequence         Int
  content          String
  status           SermonPostStatus @default(DRAFT)
  scheduledFor     DateTime?
  availableAt      DateTime         @default(now())
  attempts         Int              @default(0)
  approvedByUserId String?
  approvedAt       DateTime?
  sentAt           DateTime?
  telegramMessageId String?
  lastError        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([sermonId, sequence])
  @@index([status, availableAt])
  @@index([churchGroupId, status])
}

model Event {
  id                    String          @id @default(cuid())
  churchGroupId         String
  churchGroup           ChurchGroup     @relation(fields: [churchGroupId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  location              String?
  topic                 String?
  biblePassage          String?
  startsAt              DateTime
  timezone              String
  recurrence            EventRecurrence @default(NONE)
  weeklyDay             Int?
  localTime             String?
  reminderMinutesBefore Int
  active                 Boolean         @default(true)
  createdByTelegramUserId String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  reminderDeliveries     ReminderDelivery[]

  @@index([churchGroupId, active, startsAt])
}

model ReminderDelivery {
  id           String                 @id @default(cuid())
  eventId      String
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceAt DateTime
  scheduledFor DateTime
  availableAt  DateTime
  status       ReminderDeliveryStatus @default(PENDING)
  attempts     Int                    @default(0)
  sentAt       DateTime?
  lastError    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([eventId, occurrenceAt])
  @@index([status, availableAt])
}
